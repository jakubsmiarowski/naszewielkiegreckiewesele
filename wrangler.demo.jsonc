{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "naszewielkiegreckiewesele-demo",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"keep_vars": true,
	"workers_dev": false,
	"main": "@tanstack/react-start/server-entry",
	"vars": {
		"APP_MODE": "demo"
	},
	"routes": [
		{
			"pattern": "demo.naszewielkiegreckiewesele.com",
			"zone_name": "naszewielkiegreckiewesele.com",
			"custom_domain": true
		}
	]
}
